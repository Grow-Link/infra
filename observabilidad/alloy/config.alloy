// Alloy del docker-compose (escenario O2): recoge los logs de los contenedores de GrowLink y se los manda a Loki.
// Solo mira los contenedores de este proyecto de compose, y a cada linea le pone dos etiquetas: "servicio" (el nombre
// del servicio en el compose, p. ej. trivia-service) y "contenedor" (cual replica). El identificador de la peticion
// NO es una etiqueta (habria una por peticion y Loki se ahogaria): va dentro de la linea y se busca con un filtro de
// texto, ver el tablero "Logs".

discovery.docker "contenedores" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=growlink"]
  }
}

discovery.relabel "growlink" {
  targets = discovery.docker.contenedores.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "servicio"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "contenedor"
  }
}

loki.source.docker "growlink" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.growlink.output
  forward_to = [loki.process.json.receiver]
}

// Los servicios escriben JSON: de ahi sale el nivel (INFO, WARN, ERROR), que si es una etiqueta porque son pocos valores.
// Las lineas que no son JSON (RabbitMQ, Postgres, nginx) pasan igual, sin nivel.
loki.process "json" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = { nivel = "level" }
  }
  stage.labels {
    values = { nivel = "" }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
