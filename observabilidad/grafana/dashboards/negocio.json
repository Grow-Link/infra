    {
      "type": "stat",
      "title": "Sesiones iniciadas",
      "description": "En modo legacy, cada login. En modo oidc (Microsoft), la primera peticion de una persona despues de 30 minutos sin actividad, y su primer ingreso. Ver RegistroDeSesiones en usuarios-service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-growlink"
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-growlink"
          },
          "expr": "sum(increase(growlink_sesiones_iniciadas_total[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
