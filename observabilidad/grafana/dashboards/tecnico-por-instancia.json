        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Replicas que responden",
      "description": "Cuantas replicas de cada servicio contestaron el ultimo scrape de Prometheus. Una que se cae deja de contar aqui en unos segundos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-growlink"
      },
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-growlink"
          },
          "expr": "sum by (job) (up{job=~\"$servicio\"})",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Tiempo arriba",
      "description": "Desde cuando corre cada replica: un reinicio se ve como un tiempo que vuelve a 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-growlink"
      },
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-growlink"
          },
          "expr": "process_uptime_seconds{job=~\"$servicio\", instancia=~\"$instancia\"}",
          "legendFormat": "{{job}} {{instancia}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
