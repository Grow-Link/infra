        "y": 7
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Peticiones por segundo, por replica",
      "description": "Sin las de actuator (salud y scrape). Si una replica se lleva casi todo, el balanceo no esta repartiendo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-growlink"
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-growlink"
          },
          "expr": "sum by (job, instancia) (rate(http_server_requests_seconds_count{job=~\"$servicio\", instancia=~\"$instancia\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{instancia}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latencia p95, por replica",
      "description": "Aproximada con cubetas fijas (10 ms a 10 s, ver management.metrics.distribution.slo). Para el percentil exacto de una prueba, usar los scripts de infra/scripts/carga.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-growlink"
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-growlink"
          },
          "expr": "histogram_quantile(0.95, sum by (job, instancia, le) (rate(http_server_requests_seconds_bucket{job=~\"$servicio\", instancia=~\"$instancia\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{job}} {{instancia}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
