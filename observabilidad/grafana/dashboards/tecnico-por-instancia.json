{
  "uid": "growlink-tecnico",
  "title": "GrowLink - Tecnico por instancia",
  "description": "Como esta cada replica de cada servicio: trafico, latencia, errores, memoria, CPU, conexiones a la base y WebSockets. La etiqueta instancia es la misma que la cabecera X-Instancia de las respuestas (en Azure, WEBSITE_INSTANCE_ID).",
  "tags": [
    "growlink"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [
    {
      "title": "Tableros de GrowLink",
      "type": "dashboards",
      "tags": [
        "growlink"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "servicio",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-growlink"
        },
        "query": {
          "query": "label_values(up, job)",
          "refId": "var-servicio"
        },
        "definition": "label_values(up, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "instancia",
        "label": "Replica",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-growlink"
        },
        "query": {
          "query": "label_values(process_uptime_seconds{job=~\"$servicio\"}, instancia)",
          "refId": "var-instancia"
        },
        "definition": "label_values(process_uptime_seconds{job=~\"$servicio\"}, instancia)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
