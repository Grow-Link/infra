# copia este archivo como .env y cambia los valores
# (el .env no se sube a git)

# secreto con el que usuarios-service firma los tokens, los tres servicios usan el mismo
# tiene que tener minimo 32 caracteres
GROWLINK_JWT_SECRET=cambia-esto-por-un-secreto-largo-de-minimo-32-caracteres

# llave para las llamadas entre servicios (trivia-service -> usuarios-service)
GROWLINK_INTERNAL_KEY=cambia-esto-por-una-llave-interna

# contrasena de las bases de datos
DB_PASSWORD=growlink

# contrasena de RabbitMQ (el broker que comparten las replicas de trivia)
RABBITMQ_PASSWORD=growlink

# cuantas replicas de cada servicio se levantan
USUARIOS_REPLICAS=2
CURSOS_REPLICAS=2
TRIVIA_REPLICAS=3

# llave de la API de Claude, si se deja vacia el roadmap usa el modo de respaldo (sin IA)
CLAUDE_API_KEY=

# token con el que Prometheus lee /actuator/prometheus de los tres servicios (cabecera X-Metricas-Token).
# Minimo 16 caracteres. Sin el, el docker compose no arranca (y un servicio sin token deja las metricas cerradas)
METRICAS_TOKEN=cambia-esto-por-un-token-de-metricas-largo

# contrasena del usuario admin de Grafana (http://localhost:3001). Para mirar los tableros no hace falta entrar
GRAFANA_ADMIN_PASSWORD=cambia-esto

# tope de peticiones por IP y por minuto en usuarios y cursos (300 por defecto). Para una prueba de carga desde
# una sola maquina hay que subirlo o ponerlo en 0, si no lo que se mide es el tope (ver scripts/carga)
LIMITE_IP_MAXIMO_POR_MINUTO=300
